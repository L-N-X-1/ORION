# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...                          # paste your key here

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_URL=postgresql://your_user:your_password@postgres:5432/your_db
POSTGRES_DB=your_db_here
POSTGRES_USER=your_user_here
POSTGRES_PASSWORD=your_postgres_password_here

# ── Kafka ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── API Gateway ───────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── Digital Twin hand-off (not wired up yet) ───────────────────────
# digital-twin now lives in its own docker-compose project/network — this
# hostname won't resolve until the two stacks are connected (see the
# correlation TODO in the root README).
TWIN_URL=http://digital-twin:8001

# Ollama — no API key needed, just the host URL
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.3
